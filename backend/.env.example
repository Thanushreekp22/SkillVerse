# Server Configuration
PORT=5001

# MongoDB Configuration
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/skillverse
# On Render, use a MongoDB Atlas URI instead, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillverse

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES=7d

# Environment
NODE_ENV=development

# Frontend URL (for CORS) - on production set this to your Vercel URL,
# e.g. https://skillverse.vercel.app
FRONTEND_URL=http://localhost:5173